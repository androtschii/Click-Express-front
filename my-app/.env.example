# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Backend API base URL (optional; defaults to http://localhost:5114/api)
VITE_API_BASE_URL=

# Google OAuth client id from https://console.cloud.google.com (Credentials → OAuth client ID)
VITE_GOOGLE_CLIENT_ID=
